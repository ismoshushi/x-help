<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/x_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ 查看页 ============ -->
        <ScrollView
            android:id="@+id/pageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/x_text"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/x_text2"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="14dp" />

                <!-- 服务状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvServiceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_checking"
                        android:textSize="15sp"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnEnableService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_open_service"
                        android:background="@drawable/btn_primary"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp" />
                </LinearLayout>

                <!-- 今日使用 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/hero_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_today"
                        android:textSize="13sp"
                        android:textColor="@color/x_blue_dark"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvTodayBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTodayMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_hours"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/track_bg"
                        android:padding="14dp"
                        android:layout_marginBottom="2dp">

                        <LinearLayout
                            android:id="@+id/hourBars"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:orientation="horizontal"
                            android:gravity="bottom" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hours_axis"
                        android:textSize="11sp"
                        android:textColor="@color/x_hint"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- 账号数据 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_outline"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_account"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvFollowersNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/x_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_followers"
                                android:textSize="12sp"
                                android:textColor="@color/x_text2" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/x_border"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvFollowingNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/x_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_following"
                                android:textSize="12sp"
                                android:textColor="@color/x_text2" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/x_border"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvPostsNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/x_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_posts"
                                android:textSize="12sp"
                                android:textColor="@color/x_text2" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSnapTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_snapshot"
                        android:textSize="12sp"
                        android:textColor="@color/x_hint"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- 最近7天 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_week"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ============ 设置页 ============ -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/x_text"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="14dp" />

                <!-- 账号 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_handle"
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etHandle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@idsahm"
                        android:inputType="text"
                        android:textSize="15sp"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_package"
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etPackage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="com.twitter.android"
                        android:inputType="text"
                        android:textSize="15sp"
                        android:padding="14dp"
                        android:layout_marginBottom="14dp" />

                    <Button
                        android:id="@+id/btnSaveSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_save"
                        android:background="@drawable/btn_primary"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />
                </LinearLayout>

                <!-- 悬浮窗 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_overlay"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_checking"
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnTestBall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_test_ball"
                        android:background="@drawable/btn_primary"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnOverlayPerm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_overlay_perm"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_blue"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp" />
                </LinearLayout>

                <!-- 后台保活 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_keepalive"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_battery"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvAlarmStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnAlarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_alarm"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp" />
                </LinearLayout>

                <!-- 数据导出 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_export"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_export_csv"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnDump"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_dump"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvDumpPath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/x_hint"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnShareDump"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_share_dump"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp" />


                    <Button
                        android:id="@+id/btnResetDay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_reset_day"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_blue"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- 运行日志 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_log"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_hint"
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnExportLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_export_log"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp" />
                </LinearLayout>

                <!-- 节点校准 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_calib"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvCalib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/x_text2"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnClearCalib"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_clear_calib"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_text"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp" />
                


                <!-- 关于 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_about"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/x_text"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_me"
                        android:background="@drawable/btn_outline"
                        android:textColor="@color/x_blue"
                        android:textSize="14sp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_me_sub"
                        android:textSize="12sp"
                        android:textColor="@color/x_hint"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/x_hint" />
                </LinearLayout></LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/x_border" />

    <!-- 底部导航（M3 Expressive 风格：胶囊选中指示） -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/x_bg">

        <LinearLayout
            android:id="@+id/tabStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabStatsIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="18sp"
                android:background="@drawable/tab_pill"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <TextView
                android:id="@+id/tabStatsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_stats"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/x_blue"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabSettingsIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="18sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings"
