<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- X 浅色风格配色 -->
    <color name="x_bg">#FFFFFF</color>
    <color name="x_card">#F7F9F9</color>
    <color name="x_border">#EFF3F4</color>
    <color name="x_text">#0F1419</color>
    <color name="x_text2">#536471</color>
    <color name="x_hint">#8B98A5</color>
    <color name="x_blue">#1D9BF0</color>
    <color name="x_blue_dark">#1A8CD8</color>
